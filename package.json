{
  "name": "sunlight-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based multiplayer ski simulator of Sunlight Mountain Resort, Glenwood Springs, Colorado",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config client/vite.config.ts",
    "start:server": "tsx server/src/index.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "data": "bash pipeline/run_all.sh",
    "data:snow": ".venv/bin/python pipeline/build_snow.py",
    "data:skier": "tsx pipeline/build_skier.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:pipeline": ".venv/bin/python pipeline/test_pipeline.py",
    "data:audio": ".venv/bin/python pipeline/build_audio.py",
    "data:sopris": ".venv/bin/python pipeline/build_sopris.py",
    "test:sopris": ".venv/bin/python pipeline/test_sopris.py"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
